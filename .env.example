# === Safety ===
LIVE_TRADING=false
# Never put a real private key here unless you fully understand the risks.
# PRIVATE_KEY=   # base58 or JSON array – only if LIVE_TRADING=true

# === RPC (strongly recommend Helius or similar paid endpoint) ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# When HELIUS_API_KEY is set, main.py can prefer Helius RPC automatically.

# === Filters (match the original post spirit) ===
MIN_LIQUIDITY_USD=15000
MAX_DEV_HOLDINGS_PCT=10.0
REQUIRE_LP_LOCKED=true
MIN_LP_LOCKED_PCT=80.0

# === Risk / Sizing ===
PAPER_STARTING_BALANCE=64.0
MAX_POSITION_PCT=5.0
TAKE_PROFIT_PCT=40.0
STOP_LOSS_PCT=25.0

# === Loop ===
POLL_INTERVAL_SECONDS=30
MAX_CANDIDATES_PER_CYCLE=15

# === Real data APIs (recommended) ===
# Helius – RPC + Parsed Streams / webhooks for new tokens & trades
HELIUS_API_KEY=

# Birdeye – holder profiles (dev / sniper / bundler / whales)
BIRDEYE_API_KEY=

# Jupiter – quotes & swap transactions (needed for any live path)
JUPITER_API_KEY=

# RugCheck – higher rate limits / fresher LP + risk reports
RUGCHECK_API_KEY=

# Optional Grok reasoning layer
XAI_API_KEY=
